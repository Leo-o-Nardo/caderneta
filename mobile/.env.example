# Endereço da API. O emulador Android enxerga o PC como 10.0.2.2; num celular de verdade,
# use o IP do PC na rede (ex.: http://192.168.0.10:8100/api/v1).
EXPO_PUBLIC_API_URL=http://10.0.2.2:8100/api/v1

# WebSocket do Reverb (as respostas do assistente chegando ao vivo). Mesmo host da API, porta 8180.
EXPO_PUBLIC_REVERB_URL=ws://10.0.2.2:8180
# A chave pública do Reverb: a mesma REVERB_APP_KEY do backend/.env.
EXPO_PUBLIC_REVERB_KEY=troque-pela-chave-do-backend
