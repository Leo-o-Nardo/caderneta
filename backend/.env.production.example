# O .env de produção. No servidor: cp backend/.env.production.example backend/.env e preencha o que
# está marcado com PREENCHA. Troque caderneta.example.com pelo endereço real.
# Evite o caractere $ nas senhas: o Docker Compose lê este arquivo e trataria o $ como variável.

APP_NAME="Caderneta"
APP_ENV=production
# PREENCHA: gere com  echo "base64:$(openssl rand -base64 32)"  e cole o resultado inteiro.
APP_KEY=
APP_DEBUG=false
APP_URL=https://caderneta.example.com
INVITE_URL=https://caderneta.example.com/convite

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Os logs vão para a saída do container: docker compose ... logs app
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# O banco é o container "postgres"; o Compose cria o banco e o usuário com estes valores.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=caderneta
DB_USERNAME=caderneta
# PREENCHA: uma senha longa (ex.: openssl rand -hex 24).
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb

# PREENCHA a KEY e o SECRET (ex.: openssl rand -hex 16 para cada). A KEY é pública e vai no app
# (EXPO_PUBLIC_REVERB_KEY); o SECRET fica só aqui.
REVERB_APP_ID=caderneta
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Para onde o backend manda os eventos: o container "reverb", pela rede interna do Docker.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

ASSISTANT_PROVIDER=gemini
ASSISTANT_DAILY_LIMIT=150

# PREENCHA: a chave do Google AI Studio, com o faturamento ativo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
ASSISTANT_TRANSCRIBER=gemini
# Quanto a IA "pensa" ao transcrever a voz. "minimal" é o mais barato, mas só o Flash-Lite aceita:
# com o gemini-3.8-flash, use "low", senão todo áudio volta como "Não entendi o áudio".
GEMINI_TRANSCRIPTION_THINKING_LEVEL=minimal

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# PREENCHA: o mesmo envio de e-mail que você já usa (ex.: Gmail com senha de app).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# PREENCHA: quem recebe os pedidos de cadastro para liberar ou recusar (e as respostas reportadas no Chat).
ADMIN_EMAIL=

# A política de privacidade (/privacidade): quem responde pelos dados (quem publica o app nas lojas)
# e o e-mail de contato. Sem o contato, vale o ADMIN_EMAIL.
PRIVACY_CONTROLLER="Leonardo Ferreira"
CONTACT_EMAIL=
