APP_NAME="Caderneta"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100
INVITE_URL=http://localhost:8100/convite

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=home_finance
DB_USERNAME=home_finance
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Reverb: o servidor de WebSocket. A chave (KEY) é pública e vai no app; o segredo fica só aqui.
# Gere valores próprios: o app precisa da mesma KEY (EXPO_PUBLIC_REVERB_KEY).
REVERB_APP_ID=home-finance
REVERB_APP_KEY=troque-esta-chave
REVERB_APP_SECRET=troque-este-segredo
# Para onde o backend (e a fila) manda os eventos: o container "reverb", pela rede do Docker.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Onde o servidor escuta dentro do container (fora, a porta é a 8180).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# O assistente: "fake" responde por regras, sem chave; "gemini" é a IA real (precisa da chave).
ASSISTANT_PROVIDER=fake
ASSISTANT_FAKE_DELAY_MS=40
ASSISTANT_DAILY_LIMIT=150

# Chave do Google AI Studio (aistudio.google.com). Ative o faturamento: no nível gratuito, o Google
# usa as conversas para melhorar os produtos dele.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
# Quanto a IA "pensa" ao transcrever a voz. "minimal" é o mais barato, mas só o Flash-Lite aceita:
# com o gemini-3.8-flash, use "low", senão todo áudio volta como "Não entendi o áudio".
GEMINI_TRANSCRIPTION_THINKING_LEVEL=minimal

# Quem transcreve as mensagens de voz (usa a mesma chave do Gemini). "fake" é só para os testes.
ASSISTANT_TRANSCRIBER=gemini

CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mails (código de senha, pedidos de cadastro, acesso liberado). Assim, caem no Mailpit
# (http://localhost:8025). Para enviar de verdade pelo Gmail, use uma conta só para isso, com
# verificação em 2 etapas e uma "senha de app" (myaccount.google.com/apppasswords):
#   MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_USERNAME=conta@gmail.com
#   MAIL_PASSWORD="senha de app"  MAIL_FROM_ADDRESS=conta@gmail.com
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Quem recebe os pedidos de cadastro para liberar ou recusar (o link do e-mail usa o APP_URL).
ADMIN_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
